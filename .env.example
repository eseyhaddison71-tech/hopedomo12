# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://hopebridge_user:password@localhost:5432/hopebridge_db?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="replace-with-a-secure-random-64-character-jwt-secret-key"

# Payment: MTN Mobile Money Official API credentials (Cameroon)
MTN_MOMO_PRIMARY_KEY=""
MTN_MOMO_SECONDARY_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENV="sandbox" # "sandbox" or "mtncameroon" (production)
MTN_MOMO_COLLECTION_CALLBACK_URL="https://your-domain.org/api/payments/mtn/callback"

# Payment: PayPal Official Credentials
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_RECEIVING_EMAIL="eseyhaddison71@gmail.com"
PAYPAL_MODE="sandbox" # "sandbox" or "live"

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_FROM="HopeBridge Cameroon <donations@hopebridge-cameroon.org>"
ADMIN_NOTIFICATION_EMAIL="eseyhaddison71@gmail.com"

